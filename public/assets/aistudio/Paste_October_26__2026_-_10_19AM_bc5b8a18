  const $ = id => document.getElementById(id);
  let identity=null, answers=Array(50).fill(null), current=0, phase='identity', violations=0, ready=false, audio=null, alarmTimer=null, submitting=false;
  const show = view => { ['identity-view','exam-view','result-view'].forEach(id=>$(id).classList.toggle('hidden',id!==view)); };
  function answered(i) {
    const a=answers[i];
    return Array.isArray(a) && (questions[i].type==='PGK Kategori' ? a.every(v=>v!==null) : a.length>0) || (typeof a==='number');
  }
  function renderNav() {
    const nav=$('question-nav'); nav.replaceChildren();
    questions.forEach((_,i)=>{
      const b=document.createElement('button'); b.type='button'; b.className='number-btn'+(i===current?' current':'')+(answered(i)?' answered':'');
      b.textContent=String(i+1); b.setAttribute('aria-label','Soal '+(i+1)+(answered(i)?', terjawab':''));
      b.setAttribute('aria-current',i===current?'step':'false');
      b.addEventListener('click',()=>{current=i;render();}); nav.append(b);
    });
  }
  function option(text,type,name,checked,onChange) {
    const label=document.createElement('label');label.className='choice flex gap-3 items-center p-4';
    const input=document.createElement('input');input.type=type;input.name=name;input.checked=checked;
    input.addEventListener('change',onChange);
    const span=document.createElement('span');span.textContent=text;label.append(input,span);return label;
  }
  function render() {
    const q=questions[current]; $('question-counter').textContent=`Soal ${current+1} / 50`;
    $('progress-fill').style.width=((current+1)/50*100)+'%'; $('progress').setAttribute('aria-valuenow',String(current+1));
    $('question-type').textContent=q.type; $('question-text').textContent=q.text;
    $('question-hint').textContent=q.type==='PGK Kategori'?'Pilih Benar atau Salah untuk setiap pernyataan.':q.type==='PGK MCMA'?'Pilih semua jawaban yang benar.':'Pilih satu jawaban yang paling tepat.';
    const area=$('answer-area');area.replaceChildren();
    if(q.type==='PGK Kategori') {
      q.statements.forEach((statement,j)=>{
        const group=document.createElement('fieldset');group.className='rounded-xl border border-[#d8e2e5] p-4';
        const legend=document.createElement('legend');legend.className='font-semibold px-1';legend.textContent='ABC'[j]+'. '+statement;group.append(legend);
        const row=document.createElement('div');row.className='flex flex-wrap gap-3 mt-3';
        [true,false].forEach(v=>row.append(option(v?'Benar':'Salah','radio','cat-'+current+'-'+j,answers[current]?.[j]===v,()=>{
          const next=answers[current]?.slice()||[null,null,null];next[j]=v;answers[current]=next;renderNav();
        })));group.append(row);area.append(group);
      });
    } else q.options.forEach((text,j)=>area.append(option('ABCDE'[j]+'. '+text,q.type==='PG'?'radio':'checkbox','q-'+current,q.type==='PG'?answers[current]===j:(answers[current]||[]).includes(j),()=>{
      if(q.type==='PG') answers[current]=j;
      else {const set=new Set(answers[current]||[]);const input=area.querySelectorAll('input')[j];input.checked?set.add(j):set.delete(j);answers[current]=[...set].sort();}
      renderNav();
    })));
    $('previous').disabled=current===0;$('next').classList.toggle('hidden',current===49);$('submit').classList.toggle('hidden',current!==49);
    renderNav();
  }
  $('identity-form').addEventListener('submit',e=>{
    e.preventDefault();
    identity={nama:$('nama').value.trim(),kelas:$('kelas').value.trim(),no_absen:$('absen').value.trim()};
    if(!identity.nama||!identity.kelas||!identity.no_absen){$('status').textContent='Lengkapi seluruh identitas.';return;}
    if(!ready){$('status').textContent='Penyimpanan hasil belum siap. Tunggu sebentar lalu coba lagi.';return;}
    // Create the audio context during a user gesture; browsers may still suspend it in a background tab.
    try { audio ||= new (window.AudioContext||window.webkitAudioContext)(); audio.resume().catch(()=>{}); } catch (_) {}
    answers=Array(50).fill(null);current=0;phase='exam';$('status').textContent='';show('exam-view');$('participant-name').textContent=`${identity.nama} · ${identity.kelas} · ${identity.no_absen}`;render();
  });
  $('previous').addEventListener('click',()=>{if(current>0){current--;render();}});
  $('next').addEventListener('click',()=>{if(current<49){current++;render();}});
  function startAlarm() {
    if(!audio||alarmTimer)return;
    const beep=()=>{
      if(!audio)return;
      try {
        if(audio.state==='suspended')audio.resume().catch(()=>{});
        const osc=audio.createOscillator(),gain=audio.createGain();
        osc.type='square';osc.frequency.value=740;gain.gain.value=.085;
        osc.connect(gain).connect(audio.destination);osc.start();osc.stop(audio.currentTime+.22);
      } catch (_) {}
    };
    beep();alarmTimer=setInterval(beep,650);
  }
  function stopAlarm(){if(alarmTimer){clearInterval(alarmTimer);alarmTimer=null;}}
  document.addEventListener('visibilitychange',()=>{
    if(document.hidden && phase==='exam' && !submitting){
      violations++;phase='interrupted';answers=Array(50).fill(null);current=0;startAlarm();
    } else if(!document.hidden && phase==='interrupted'){
      stopAlarm();phase='identity';identity=null;$('identity-form').reset();show('identity-view');
      $('status').textContent='Tab ujian ditinggalkan. Jawaban dihapus; isi identitas dan mulai lagi dari awal.';
    } else if(!document.hidden)stopAlarm();
  });
  window.addEventListener('blur',()=>{
    if(phase==='exam'&&!document.hidden&&!submitting) {
      violations++;phase='interrupted';answers=Array(50).fill(null);current=0;startAlarm();
    }
  });
  window.addEventListener('focus',()=>{
    if(phase==='interrupted'&&!document.hidden){
      stopAlarm();phase='identity';identity=null;$('identity-form').reset();show('identity-view');
      $('status').textContent='Jendela ujian ditinggalkan. Jawaban dihapus; mulai lagi dari awal.';
    }
  });
  $('submit').addEventListener('click',async()=>{
    if(submitting||phase!=='exam')return;
    const missing=answers.findIndex((_,i)=>!answered(i));
    if(missing!==-1){current=missing;render();$('status').textContent=`Jawab soal ${missing+1} sebelum mengumpulkan.`;return;}
    if(!ready){$('status').textContent='Penyimpanan belum siap. Coba lagi sebentar.';return;}
    let correct=0;
    questions.forEach((q,i)=>{
      const a=answers[i];
      if(q.type==='PG' ? a===q.correct : q.type==='PGK Kategori' ? a.every((v,j)=>v===q.correct[j]) : a.length===q.correct.length&&a.every((v,j)=>v===q.correct[j]))correct++;
    });
    const score=correct*2; submitting=true;$('submit').disabled=true;$('submit').textContent='Menyimpan…';$('status').textContent='';
    try {
      const result=await window.dataSdk.create({...identity,skor:score,total_benar:correct,total_soal:50,waktu_selesai:new Date().toISOString(),pelanggaran_tab:violations});
      if(!result.isOk)throw result.error;
      phase='result';$('result-identity').textContent=`${identity.nama} · ${identity.kelas} · Absen ${identity.no_absen}`;
      $('result-score').textContent=String(score);$('result-correct').textContent=`${correct} dari 50 soal benar`;
      show('result-view');
    } catch (_) {$('status').textContent='Hasil belum berhasil disimpan. Periksa koneksi dan coba kumpulkan lagi.';}
    finally {submitting=false;$('submit').disabled=false;$('submit').textContent='Kumpulkan jawaban';}
  });
  (async()=>{
    try {const result=await window.dataSdk.init({onDataChanged() { /* Mode kirim-saja: tidak menampilkan hasil peserta lain. */ }});
      ready=result.isOk;
      if(!ready)$('status').textContent='Penyimpanan hasil tidak tersedia. Coba buka kembali ujian.';
    } catch (_) {$('status').textContent='Penyimpanan hasil tidak tersedia. Coba buka kembali ujian.';}
  })();
})();
